% layout 'default';
% title 'Smoke DB outfile '.$id;
<h1><%= $sr->title %></h1>
<p class="links">
  [<a href="<%= $pr->report_url %>">Report</a>]
  [<a href="<%= $pr->original_url %>">via test-smoke.org</a>]
  [<a href="<%= $pr->similar_url %>">similar</a>]
  [<a href="/?s=<%= $pr->sha %>">commit</a>]
</p>
<pre id="dbreport">
<%= $outfile %>
</pre>
