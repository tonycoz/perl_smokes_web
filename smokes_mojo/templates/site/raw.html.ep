% layout 'default';
% title 'Raw report '.$id;
<h1><%= $pr->subject %></h1>
<p class="links">
[<a href="<%= $pr->original_url %>">via nntp.perl.org</a>]
[<a href="<%= $pr->similar_url %>">similar</a>]
[<a href="/?s=<%= $pr->sha %>">commit</a>]
| Technical stuff:
[<a href="/rawparsedjson/<%= $id %>" title="how we parsed the report, meant for debugging mostly">parsed detail</a>]
</p>
% if (@$others) {
<p>
  Others:
% for my $r (@$others) {
%   if ($r->nntp_id) {
<a href="/raw/<%= $r->nntp_id %>">[nntp]</a>
%   }
%   else {
<a href="/db/<%= $r->smokedb_id %>">[smokedb]</a>
%   }
% }
</p>
% }

<pre><%= $raw %></pre>

